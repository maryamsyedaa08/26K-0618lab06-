                {
                    printf("The camera is OFF\n");
                }
                break;       
        }

        printf("New combined value is: %d\n", val);

        if ((val & air) != 0 && (val & heater) != 0)
        {
            printf("OVERLOAD RISK: Heater and Air Conditioner both are ON!\n");
        }
        else
        {
            printf("Not Overloaded.\n");
        }
       printf("Entercombined value (1-15): ");
    scanf("%d", &val);
